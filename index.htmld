<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rope Swinger</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      overflow: hidden;
      background: #9edcff;
      font-family: Arial, sans-serif;
    }

    canvas {
      display: block;
      background: linear-gradient(#9edcff, #e5f8ff);
    }

    #info {
      position: fixed;
      top: 15px;
      left: 15px;
      padding: 10px 14px;
      color: #123;
      background: rgba(255, 255, 255, 0.8);
      border-radius: 10px;
      font-weight: bold;
      z-index: 2;
    }

    #restart {
      display: none;
      position: fixed;
      left: 50%;
      top: 55%;
      transform: translate(-50%, -50%);
      padding: 14px 22px;
      border: 0;
      border-radius: 10px;
      background: #ff4d67;
      color: white;
      font-size: 18px;
      cursor: pointer;
      z-index: 3;
    }
  </style>
</head>
<body>
  <div id="info">Click a blue anchor to swing. Release to fly.</div>
  <button id="restart">Play again</button>
  <canvas id="game"></canvas>

  <script>
    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");
    const restartButton = document.getElementById("restart");

    let width, height;
    let cameraX = 0;
    let gameOver = false;
    let won = false;
    let selectedAnchor = null;

    const player = {
      x: 130,
      y: 330,
      vx: 3,
      vy: 0,
      radius: 16,
      attached: false,
      ropeLength: 150,
      angle: 0,
      angularVelocity: 0
    };

    const anchors = [
      { x: 330, y: 180 },
      { x: 600, y: 290 },
      { x: 880, y: 150 },
      { x: 1160, y: 270 },
      { x: 1450, y: 130 },
      { x: 1740, y: 250 },
      { x: 2050, y: 150 }
    ];

    const obstacles = [
      { x: 450, y: 430, w: 170, h: 35 },
      { x: 740, y: 360, w: 190, h: 35 },
      { x: 1010, y: 470, w: 190, h: 35 },
      { x: 1280, y: 330, w: 190, h: 35 },
      { x: 1570, y: 440, w: 210, h: 35 },
      { x: 1860, y: 320, w: 210, h: 35 }
    ];

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    window.addEventListener("resize", resize);
    resize();

    function resetGame() {
      player.x = 130;
      player.y = 330;
      player.vx = 3;
      player.vy = 0;
      player.attached = false;
      selectedAnchor = null;
      cameraX = 0;
      gameOver = false;
      won = false;
      restartButton.style.display = "none";
    }

    function screenPosition(object) {
      return {
        x: object.x - cameraX,
        y: object.y
      };
    }

    function getMousePosition(event) {
      return {
        x: event.clientX + cameraX,
        y: event.clientY
      };
    }

    function findAnchor(x, y) {
      let closest = null;
      let distance = Infinity;

      for (const anchor of anchors) {
        const d = Math.hypot(anchor.x - x, anchor.y - y);

        if (d < distance && d < 75) {
          closest = anchor;
          distance = d;
        }
      }

      return closest;
    }

    function attachToAnchor(anchor) {
      selectedAnchor = anchor;
      player.attached = true;

      player.ropeLength = Math.hypot(
        player.x - anchor.x,
        player.y - anchor.y
      );

      player.angle = Math.atan2(
        player.y - anchor.y,
        player.x - anchor.x
      );

      player.angularVelocity = 0.035;
    }

    function release() {
      if (!player.attached || !selectedAnchor) return;

      const tangentX = -Math.sin(player.angle);
      const tangentY = Math.cos(player.angle);
      const speed = player.angularVelocity * player.ropeLength;

      player.vx = tangentX * speed + 2.5;
      player.vy = tangentY * speed;
      player.attached = false;
      selectedAnchor = null;
    }

    canvas.addEventListener("mousedown", event => {
      if (gameOver || won) return;

      const mouse = getMousePosition(event);
      const anchor = findAnchor(mouse.x, mouse.y);

      if (anchor) {
        attachToAnchor(anchor);
      } else {
        release();
      }
    });

    canvas.addEventListener("touchstart", event => {
      event.preventDefault();

      if (gameOver || won) return;

      const touch = event.touches[0];
      const rect = canvas.getBoundingClientRect();

      const mouse = {
        x: touch.clientX - rect.left + cameraX,
        y: touch.clientY - rect.top
      };

      const anchor = findAnchor(mouse.x, mouse.y);

      if (anchor) {
        attachToAnchor(anchor);
      } else {
        release();
      }
    }, { passive: false });

    window.addEventListener("mouseup", release);
    window.addEventListener("touchend", release);

    function update() {
      if (gameOver || won) return;

      if (player.attached && selectedAnchor) {
        player.angularVelocity += Math.sin(player.angle) * 0.0009;
        player.angularVelocity *= 0.999;
        player.angle += player.angularVelocity;

        player.x =
          selectedAnchor.x + Math.cos(player.angle) * player.ropeLength;

        player.y =
          selectedAnchor.y + Math.sin(player.angle) * player.ropeLength;
      } else {
        player.vy += 0.35;
        player.vx *= 0.998;
        player.x += player.vx;
        player.y += player.vy;
      }

      cameraX += (player.x - cameraX - width * 0.35) * 0.08;
      cameraX = Math.max(0, cameraX);

      if (player.y > height + 100) {
        gameOver = true;
        restartButton.style.display = "block";
      }

      for (const obstacle of obstacles) {
        const hit =
          player.x + player.radius > obstacle.x &&
          player.x - player.radius < obstacle.x + obstacle.w &&
          player.y + player.radius > obstacle.y &&
          player.y - player.radius < obstacle.y + obstacle.h;

        if (hit) {
          gameOver = true;
          restartButton.style.display = "block";
        }
      }

      if (player.x > 2250) {
        won = true;
        restartButton.textContent = "You won! Play again";
        restartButton.style.display = "block";
      }
    }

    function drawPlayer() {
      const p = screenPosition(player);

      ctx.save();
      ctx.translate(p.x, p.y);

      // Head
      ctx.beginPath();
      ctx.arc(0, -24, 10, 0, Math.PI * 2);
      ctx.fillStyle = "#222";
      ctx.fill();

      // Body
      ctx.strokeStyle = "#222";
      ctx.lineWidth = 6;
      ctx.lineCap = "round";

      ctx.beginPath();
      ctx.moveTo(0, -14);
      ctx.lineTo(0, 17);
      ctx.stroke();

      // Arms
      ctx.beginPath();
      ctx.moveTo(0, -5);
      ctx.lineTo(-17, 8);
      ctx.moveTo(0, -5);
      ctx.lineTo(17, 8);
      ctx.stroke();

      // Legs
      ctx.beginPath();
      ctx.moveTo(0, 17);
      ctx.lineTo(-15, 37);
      ctx.moveTo(0, 17);
      ctx.lineTo(15, 37);
      ctx.stroke();

      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      // Finish zone
      ctx.fillStyle = "#55c878";
      ctx.fillRect(2220 - cameraX, 0, 80, height);

      ctx.fillStyle = "#176b3a";
      ctx.font = "bold 18px Arial";
      ctx.fillText("FINISH", 2228 - cameraX, 80);

      // Obstacles
      for (const obstacle of obstacles) {
        ctx.fillStyle = "#f05b62";
        ctx.fillRect(
          obstacle.x - cameraX,
          obstacle.y,
          obstacle.w,
          obstacle.h
        );

        ctx.fillStyle = "#c73945";
        ctx.fillRect(
          obstacle.x - cameraX,
          obstacle.y,
          obstacle.w,
          8
        );
      }

      // Anchors
      for (const anchor of anchors) {
        const a = screenPosition(anchor);

        ctx.beginPath();
        ctx.arc(a.x, a.y, 12, 0, Math.PI * 2);
        ctx.fillStyle = "#1677ff";
        ctx.fill();

        ctx.beginPath();
        ctx.arc(a.x, a.y, 5, 0, Math.PI * 2);
        ctx.fillStyle = "#d8efff";
        ctx.fill();
      }

      // Rope
      if (player.attached && selectedAnchor) {
        const p = screenPosition(player);
        const a = screenPosition(selectedAnchor);

        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(a.x, a.y);
        ctx.strokeStyle = "#333";
        ctx.lineWidth = 3;
        ctx.stroke();
      }

      drawPlayer();

      if (gameOver || won) {
        ctx.fillStyle = "rgba(0, 0, 0, 0.45)";
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = "white";
        ctx.font = "bold 42px Arial";
        ctx.textAlign = "center";
        ctx.fillText(
          won ? "Level complete!" : "Try again!",
          width / 2,
          height / 2
        );
        ctx.textAlign = "left";
      }
    }

    function gameLoop() {
      update();
      draw();
      requestAnimationFrame(gameLoop);
    }

    restartButton.addEventListener("click", resetGame);
    gameLoop();
  </script>
</body>
</html>
